# Copy to `server/env` (or `.env`) and fill in values.

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

MONGO_URI=
JWT_SECRET=

# Microblink BlinkID Verify — seller identity KYC (ID scan + selfie face match)
# Region controls which API host is used (switch per deployment without code changes):
#   EU        → https://eu.verify.microblink.com   (default for development)
#   us-east   → https://us-east.verify.microblink.com
#   ca        → https://ca.verify.microblink.com
# Aliases: US, USA, europe, canada also work.
MICROBLINK_LICENSE_KEY=
# Plain secret (on Render, quote the value if it contains + or =):
MICROBLINK_SECRET=
# Recommended on Render — avoids + and = being mangled in the dashboard:
# MICROBLINK_SECRET_B64=<base64 of the raw secret>
MICROBLINK_REGION=EU
# Doc scan calls Microblink (timeout ~28s). Render HTTP limit is ~30s; do not raise timeout above that.
